# Copy to .env and adjust. .env is gitignored.
POSTGRES_DB=techies
POSTGRES_USER=techies
POSTGRES_PASSWORD=techies_local_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# HS256 signing key shared by identity-service (issuer) and api-gateway (validator).
# Must be at least 32 bytes for HS256.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_TTL_DAYS=30

EUREKA_URL=http://discovery-server:8761/eureka/

# Gemini API key for the product assistant. Get one free at https://aistudio.google.com
# Without it the chat endpoint reports the assistant as unavailable; nothing else changes.
GEMINI_API_KEY=

# Gmail SMTP, used only to deliver the 6-digit verification codes for sign-up and password
# reset. MAIL_PASSWORD must be a Google *app password* (16 characters, requires 2FA on the
# account), never the account's own login password.
# Leave MAIL_USERNAME empty to disable delivery: codes are still issued and the endpoints
# still work, but nothing is sent, which is what the tests and an offline demo rely on.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Techies
